# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build
/public/maplibre-gl-worker.mjs
/public/ort/
/public/tts/

# the saved base map, fetched by `npm run basemap` (docs/setup.md); the label fonts in public/glyphs/ are in git
/public/basemap/

# local copy of the voice model (see scripts/prepare-tts.mjs)
/models/

# local tooling
.claude/settings.local.json
# one worktree per session (CONTRIBUTING.md, Git workflow)
/.claude/worktrees/

# native transmitter app (it also has its own .gitignore); keeps these out of git and out of Vercel uploads
/transmitter/node_modules
/transmitter/.expo
/transmitter/ios
/transmitter/android

# shared record of reports (lib/reports/store.ts)
/.data/

# State and logs of the removed launcher (decision 262), still in older checkouts
/.run/
