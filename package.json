{
  "name": "edth-hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/copy-maplibre-worker.mjs && node scripts/prepare-tts.mjs",
    "build": "next build --webpack",
    "prebuild": "node scripts/copy-maplibre-worker.mjs && node scripts/prepare-tts.mjs",
    "start": "next start -p 3117",
    "demo": "node scripts/demo.mjs",
    "lint": "eslint",
    "test": "vitest run",
    "stt": "node scripts/stt-server.mjs",
    "stt:prepare": "node scripts/stt-server.mjs --prepare",
    "phone": "npm run start --prefix transmitter -- --dev-client --port 8082",
    "gazetteer": "tsx scripts/build-gazetteer.ts",
    "basemap": "tsx scripts/build-basemap.ts",
    "scenarios": "node scripts/build-scenarios.mjs && tsx scripts/build-transmitter-hints.ts",
    "eval:extract": "tsx scripts/eval-extraction.ts",
    "eval:format": "tsx scripts/eval-format.ts",
    "eval:outcomes": "tsx scripts/eval-outcomes.ts",
    "eval:baseline": "tsx scripts/eval-baseline.ts",
    "eval:replies": "tsx scripts/eval-replies.ts",
    "eval:callsigns": "tsx scripts/eval-callsigns.ts",
    "eval:requests": "tsx scripts/eval-requests.ts",
    "eval:stage": "tsx scripts/eval-stage.ts"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "maplibre-gl": "^6.19.0",
    "milsymbol": "^3.0.5",
    "next": "16.4.6",
    "onnxruntime-web": "1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
