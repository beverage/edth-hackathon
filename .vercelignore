# What the Vercel CLI must not upload when it deploys from this folder.
# CLI 64 does not read .gitignore (checked on 21 November with `vercel deploy --prod --dry`),
# so what .gitignore keeps out is listed again here. Check a change with the same command.

# the native app: not part of the site; with its iOS build it is 20,000 files and 2 GB
/transmitter

# generated at build
/public/maplibre-gl-worker.mjs
/public/ort
/public/tts

# the saved base map for offline mode (npm run basemap); the hosted site uses OpenFreeMap
/public/basemap

# local copy of the voice model, and the record of reports
/models
/.data

# local tooling and build leftovers
/.claude
/coverage
*.tsbuildinfo
next-env.d.ts

# macOS
.DS_Store

# env files
.env*
!.env.example

# State and logs of the removed launcher (decision 262), still in older checkouts
/.run/
